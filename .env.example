APP_NAME="Miral Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=miral_store
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@miral.sa"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# Salla Integration (إعدادات الربط مع منصة سلة)
# ==============================================================================
# SALLA_DRIVER: 'auto' (يفحص المفاتيح ثم يعود للتجريبي), 'mock' (بيانات تجريبية), 'http' (اتصال حقيقي بسلة)
SALLA_DRIVER=auto
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI="${APP_URL}/admin/integrations/salla/callback"
SALLA_API_URL=https://api.salla.dev/admin/v2
SALLA_CHECKOUT_API_URL=https://api.salla.dev/store/v2/checkout
SALLA_MERCHANT_ID=
SALLA_STORE_IDENTIFIER=
SALLA_WEBHOOK_SECRET=
SALLA_WEBHOOKS_ENABLED=true

# ==============================================================================
# Social Authentication (Google / Apple)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

# ==============================================================================
# Frontend & Vite
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"